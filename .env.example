# Copy this file to .env. The defaults work for trying Cirrus on your own computer.

# Database password. Replace it before going online.
POSTGRES_PASSWORD=cirrus

# The address people use to reach the site.
PUBLIC_URL=http://localhost:3000

# Local AI. Set CIRRUS_AI_ENABLED=false to use built-in answers only.
CIRRUS_AI_ENABLED=true
OLLAMA_MODEL=llama3.2

# Used for dates such as "this month".
CIRRUS_TIMEZONE=America/Toronto

# Shows a GitHub link on the home page. Applied when the site is built.
NEXT_PUBLIC_GITHUB_URL=

# Production only (see docs/DEPLOYMENT.md).
DOMAIN=
CIRRUS_DOCS_ENABLED=true
CIRRUS_SMTP_HOST=
CIRRUS_SMTP_PORT=587
CIRRUS_SMTP_USERNAME=
CIRRUS_SMTP_PASSWORD=
CIRRUS_SMTP_FROM="Cirrus <no-reply@example.com>"
